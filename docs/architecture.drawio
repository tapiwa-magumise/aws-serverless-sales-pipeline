FFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-3-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-3-desc-legend" value="&lt;div&gt;&lt;b&gt;Validate&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Lambda validates every row. At most 2 copies run at once.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-3-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-4-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="186" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-4-badge-legend" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-4-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-4-desc-legend" value="&lt;div&gt;&lt;b&gt;Land&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Valid rows, and rejected rows with reasons, go to the curated bucket by date.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-4-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-5-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="248" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-5-badge-legend" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-5-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-5-desc-legend" value="&lt;div&gt;&lt;b&gt;Audit&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Each file gets one audit record; a conditional write blocks duplicates.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-5-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-6-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="310" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-6-badge-legend" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-6-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-6-desc-legend" value="&lt;div&gt;&lt;b&gt;Catalog&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The Glue Data Catalog describes the files with partition projection.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-6-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-7-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="372" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-7-badge-legend" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-7-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-7-desc-legend" value="&lt;div&gt;&lt;b&gt;Query&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Analysts query with Athena, capped at 10 MB scanned per query.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-7-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-8-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="434" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-8-badge-legend" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-8-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-8-desc-legend" value="&lt;div&gt;&lt;b&gt;Dead letter&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;After 3 failures a file moves to the dead-letter queue.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-8-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-9-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="496" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-9-badge-legend" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-9-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-9-desc-legend" value="&lt;div&gt;&lt;b&gt;Alarm&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;CloudWatch alarms on dead-letter depth and Lambda errors.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-9-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="step-10-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="558" width="600" height="58" as="geometry" /></mxCell><mxCell id="step-10-badge-legend" value="10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-10-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell><mxCell id="step-10-desc-legend" value="&lt;div&gt;&lt;b&gt;Email&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The alerts topic emails operations.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-10-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell><mxCell id="legend-aux-note" value="&lt;i&gt;Auxiliary: a budget alert emails on any spend. GitHub Actions deploys with a short-lived OIDC token through the deploy role; there are no stored keys.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;fontColor=light-dark(#333333,#D4D4D4);fontFamily=Helvetica;" vertex="1" parent="legend-container"><mxGeometry x="0" y="624" width="600" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>