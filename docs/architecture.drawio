nt="1"><mxGeometry x="1470" y="875" width="24" height="24" as="geometry"/></mxCell><mxCell id="c58" value="How it works" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1730" y="100" width="250" height="24" as="geometry"/></mxCell><mxCell id="c59" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1730" y="136" width="20" height="20" as="geometry"/></mxCell><mxCell id="c60" value="Branch staff upload a sales CSV to the raw bucket." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1758" y="134" width="230" height="64" as="geometry"/></mxCell><mxCell id="c61" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1730" y="198" width="20" height="20" as="geometry"/></mxCell><mxCell id="c62" value="S3 sends an event to the SQS queue, which buffers bursts and retries failures." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1758" y="196" width="230" height="64" as="geometry"/></mxCell><mxCell id="c63" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1730" y="260" width="20" height="20" as="geometry"/></mxCell><mxCell id="c64" value="Lambda validates every row. At most 2 copies run at once." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1758" y="258" width="230" height="64" as="geometry"/></mxCell><mxCell id="c65" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1730" y="322" width="20" height="20" as="geometry"/></mxCell><mxCell id="c66" value="Valid rows, and rejected rows with reasons, go to the curated bucket by date." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1758" y="320" width="230" height="64" as="geometry"/></mxCell><mxCell id="c67" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1730" y="384" width="20" height="20" as="geometry"/></mxCell><mxCell id="c68" value="Each file gets one audit record. A conditional write blocks duplicates." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1758" y="382" width="230" height="64" as="geometry"/></mxCell><mxCell id="c69" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1730" y="446" width="20" height="20" as="geometry"/></mxCell><mxCell id="c70" value="Analysts query with Athena. Glue Data Catalog describes the files." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1758" y="444" width="230" height="64" as="geometry"/></mxCell><mxCell id="c71" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1730" y="508" width="20" height="20" as="geometry"/></mxCell><mxCell id="c72" value="After 3 failures a file moves to the dead-letter queue and an alarm emails operations." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1758" y="506" width="230" height="64" as="geometry"/></mxCell><mxCell id="c73" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1730" y="570" width="20" height="20" as="geometry"/></mxCell><mxCell id="c74" value="A budget alert emails on any spend." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1758" y="568" width="230" height="64" as="geometry"/></mxCell><mxCell id="c75" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1730" y="632" width="20" height="20" as="geometry"/></mxCell><mxCell id="c76" value="GitHub Actions deploys with a short-lived OIDC token. No stored keys." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1758" y="630" width="230" height="64" as="geometry"/></mxCell><mxCell id="c77" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1730" y="702" width="250" height="20" as="geometry"/></mxCell><mxCell id="c78" value="Grey line: data flow&lt;br&gt;Red dashed: failure and alerting&lt;br&gt;Pink dashed: identity and deployment&lt;br&gt;Green dashed: cost alert" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1730" y="724" width="250" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>