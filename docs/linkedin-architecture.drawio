arent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s0-h" value="What it does" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=24;fontStyle=1;" vertex="1" parent="1" ><mxGeometry x="50" y="345" width="800" height="34" as="geometry"/></mxCell><mxCell id="s0-0" value="Checks every row of each branch&#x27;s weekly sales file" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="395" width="800" height="34" as="geometry"/></mxCell><mxCell id="s0-1" value="Keeps rejected rows with every reason they failed" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="437" width="800" height="34" as="geometry"/></mxCell><mxCell id="s0-2" value="Writes one audit record per file in DynamoDB" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="479" width="800" height="34" as="geometry"/></mxCell><mxCell id="s0-3" value="Counts a file uploaded twice only once" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="521" width="800" height="34" as="geometry"/></mxCell><mxCell id="s0-4" value="Retries a failed file 3 times, then emails someone" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="563" width="800" height="34" as="geometry"/></mxCell><mxCell id="s1-h" value="How it&#x27;s run" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=24;fontStyle=1;" vertex="1" parent="1" ><mxGeometry x="50" y="650" width="800" height="34" as="geometry"/></mxCell><mxCell id="s1-0" value="Everything in Terraform, deployed by GitHub Actions" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="700" width="800" height="34" as="geometry"/></mxCell><mxCell id="s1-1" value="CI signs in to AWS with OIDC: no stored keys" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="742" width="800" height="34" as="geometry"/></mxCell><mxCell id="s1-2" value="Every bucket blocks public access and refuses non-TLS requests" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="784" width="800" height="34" as="geometry"/></mxCell><mxCell id="s1-3" value="Checkov scans every change" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="826" width="800" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>